# Airtable read-only access (never commit real values)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_API_URL=https://api.airtable.com/v0
# Optional comma-separated table names; defaults to the canonical eight tables.
AIRTABLE_TABLES=
# Optional local paths for per-table response caches and the aggregate snapshot.
AIRTABLE_CACHE_DIR=data/raw/cache
AIRTABLE_SNAPSHOT_PATH=data/raw/airtable_snapshot.json

# Optional provider selection; mock is safe for offline development
RI_PROVIDER=mock
GEMINI_API_KEY=
